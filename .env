# Database
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
EXTERNAL_PORT=

PORT=3000

# JWT para autenticación
JWT_SECRET=
JWT_EXPIRATION=

# SMTP para envío de emails (OPCIONAL - si no lo configuras, los emails se muestran en consola)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# URL del frontend (para los enlaces en los emails)
FRONTEND_URL=http://localhost:3001

# Entorno
NODE_ENV=development